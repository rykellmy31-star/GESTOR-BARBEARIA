# ─────────────────────────────────────────────────────────────────────────────
# Este arquivo descreve TODAS as variáveis/secrets usados pelo projeto.
# Em desenvolvimento local, copie para `.dev.vars` (usado pelo wrangler dev).
# Em produção (Cloudflare), configure com `wrangler secret put NOME`.
# NUNCA commite arquivos .dev.vars ou segredos reais no GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# OBRIGATÓRIO em produção. Segredo usado para derivar tokens de sessão.
# Gere um valor forte com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-64-hex

# Ambiente ("development" ou "production"). Em produção o fallback inseguro
# do SESSION_SECRET é desabilitado.
APP_ENV=development

# ── INTEGRAÇÃO OPCIONAL COM WHATSAPP (Meta Cloud API) ────────────────────────
# O sistema funciona 100% sem estas variáveis. Quando ausentes, os avisos de
# WhatsApp ficam registrados na tabela `whatsapp_outbox` como "não enviado
# (provedor não configurado)" e os links de confirmação manual continuam
# funcionando. Nada é simulado como enviado.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
# Nº de destino administrativo (somente dígitos, com DDI), ex.: 5575999990000
WHATSAPP_ADMIN_NUMBER=
