{
  "name": "tigu-production",
  "main": "api/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "production",
    "TIGU_STAGING": "0",
    "WHATSAPP_MOCK": "0",
    "PAYMENTS_MOCK": "0",
    "MERCHANT_PIX_ENABLED": "0"
  },
  "observability": {"enabled": true},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tigu-production-db",
      "database_id": "REPLACE_ONLY_AFTER_CREATING_ISOLATED_PRODUCTION_D1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {"binding": "MEDIA", "bucket_name": "tigu-production-media"}
  ],
  "triggers": {"crons": []}
}
