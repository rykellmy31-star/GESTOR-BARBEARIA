# ============================================================================
# Copie para .dev.vars (gitignored) — só para `wrangler dev`.
# Em produção use `wrangler secret put <NOME>`. Tudo abaixo é OPCIONAL em dev
# (há fallbacks inseguros propositalmente, só para desenvolvimento local).
# ============================================================================

# --- núcleo -----------------------------------------------------------------
# Assinatura de sessões/cookies. Qualquer string longa: openssl rand -hex 32
SESSION_SECRET=troque…ucao
# Chave AES-GCM que cifra tokens de WhatsApp no D1 (rotação invalida conexões)
MSG_ENC_KEY=

# --- Evolution API v2 (único provedor real WhatsApp) -------------------
# Simulador para testes locais; NÃO é provedor real.
WHATSAPP_MOCK=1
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
PUBLIC_URL=https://agendamentos.crjornada.com

# --- pagamentos (Pix) — ver docs/PAGAMENTOS.md ------------------------------
# PAYMENTS_MOCK=1 habilita "simular pagamento" na carteira (demo/testes)
PAYMENTS_MOCK=1
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPA…ken=
# Segredo do webhook do gateway p/ validar x-signature
MERCADOPAGO_WEBHOOK_SECRET=

# --- e-mail transacional (opcional; sem isto só WhatsApp/notificações internas)
RESEND_API_KEY=
